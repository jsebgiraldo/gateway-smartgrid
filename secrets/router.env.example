# Upstream router @ 192.168.8.1
# Copy this file to router.env and fill in OPENWRT_PASSWORD.
# router.env is gitignored — never commit credentials.

OPENWRT_HOST=192.168.8.1
OPENWRT_PORT=22
OPENWRT_USER=root
OPENWRT_PASSWORD=

SSH_TIMEOUT=30
SSH_KEEPALIVE_INTERVAL=15

ENABLE_COMMAND_VALIDATION=true
ENABLE_AUDIT_LOGGING=true
LOG_FILE=/app/logs/router_mcp.log
