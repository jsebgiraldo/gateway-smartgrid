# ThingsBoard MCP -> Pi4 edge tb-edge (192.168.8.111, HTTP_BIND_PORT=8090)
# Copy this file to thingsboard-pi4-edge.env and fill in THINGSBOARD_API_KEY.
# thingsboard-pi4-edge.env is gitignored - never commit credentials.
#
# Generate the API key in the edge TB UI:
#   http://192.168.8.111:8090  ->  user menu (top-right)  ->  Security  ->  API keys  ->  Add API key
#   (TB 4.3+ only. Use a Tenant Administrator account on the edge.)

THINGSBOARD_URL=http://192.168.8.111:8090
THINGSBOARD_API_KEY=
