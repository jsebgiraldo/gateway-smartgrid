# ThingsBoard MCP -> Emsitech TB (100.67.60.126 via Tailscale, port 80)
# Copy this file to thingsboard-emsitech.env and fill in credentials.
# thingsboard-emsitech.env is gitignored - never commit credentials.
#
# Note: this instance's TB CE 4.3.1 has a quirk where API-key auth returns
# "User account is not active" even when the account IS activated. We use
# username/password auth instead, which works.

THINGSBOARD_URL=http://100.67.60.126
THINGSBOARD_USERNAME=tenant@thingsboard.org
THINGSBOARD_PASSWORD=
