# ThingsBoard MCP -> Central TB CE on this PC (gw-thingsboard, port 8080)
# Copy this file to thingsboard-local.env and fill in THINGSBOARD_API_KEY.
# thingsboard-local.env is gitignored - never commit credentials.
#
# Generate the API key in the TB UI:
#   http://localhost:8080  ->  user menu (top-right)  ->  Security  ->  API keys  ->  Add API key
#   (TB 4.3+ only. Use a Tenant Administrator account.)

THINGSBOARD_URL=http://host.docker.internal:8080
THINGSBOARD_API_KEY=
