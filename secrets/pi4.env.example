# Raspberry Pi 4 — the production edge (OTBR + tb-edge for the real LwM2M nodes)
# Copy to pi4.env and fill in OPENWRT_PASSWORD. pi4.env is gitignored.

OPENWRT_HOST=192.168.8.111
OPENWRT_PORT=22
OPENWRT_USER=root
OPENWRT_PASSWORD=

SSH_TIMEOUT=30
SSH_KEEPALIVE_INTERVAL=15

ENABLE_COMMAND_VALIDATION=true
ENABLE_AUDIT_LOGGING=true
LOG_FILE=/app/logs/pi4_mcp.log
