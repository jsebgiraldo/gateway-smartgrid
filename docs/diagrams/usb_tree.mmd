graph TB
    CM4_USB["CM4 USB 2.0<br/>480 Mbps"]
    
    HUB["USB2514BI<br/>4-port USB 2.0 Hub<br/>(del R1000)"]
    
    P1["Port 1<br/>EG25-G<br/>4G LTE<br/>(mini-PCIe USB)"]
