# ThingsBoard Edge -> central server connection.
# Copy to tb-edge-cloud.env (gitignored) and fill in from the Edge entity
# created in the central ThingsBoard UI (Edge management > Edges).
#
# The real values for this deployment are in the orchestrator's
# secrets/tb-edge-cloud.env — deploy that file to the edge as
# /opt/docker/tb-edge/tb-edge-cloud.env

CLOUD_RPC_HOST=192.168.8.124
CLOUD_RPC_PORT=7070
CLOUD_ROUTING_KEY=
CLOUD_ROUTING_SECRET=
